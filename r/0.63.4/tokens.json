{
  "$description": "Fan's look, as design tokens in the W3C design tokens format: the one source for every color and font the page names. tools/dev/tokens.js writes them into the top of fan.css as --<group>-<name> (color.ink is --color-ink, color.palette.green-49 is --color-green-49). Roles say what a color is for; the palette names every other color the page uses, by its hue and lightness, until it gets a role. A team's colors are its data, in leagues.js.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#0f1216",
      "$description": "The page under everything.",
      "$extensions": {
        "fan": {
          "light": "#e9edf2"
        }
      }
    },
    "paper": {
      "$value": "#1a1f26",
      "$description": "A card's face.",
      "$extensions": {
        "fan": {
          "light": "#ffffff"
        }
      }
    },
    "paper-edge": {
      "$value": "#2a313b",
      "$description": "A card's or field's border.",
      "$extensions": {
        "fan": {
          "light": "#d3d9e1"
        }
      }
    },
    "card-rule": {
      "$value": "#363f4b",
      "$description": "A rule inside a card, and a popup's border.",
      "$extensions": {
        "fan": {
          "light": "#bec7d2"
        }
      }
    },
    "ink": {
      "$value": "#e8ebef",
      "$description": "Text.",
      "$extensions": {
        "fan": {
          "light": "#161b22"
        }
      }
    },
    "ink-dim": {
      "$value": "#8c96a3",
      "$description": "Quieter text: labels, help, the second line.",
      "$extensions": {
        "fan": {
          "light": "#5a6472"
        }
      }
    },
    "label": {
      "$value": "#a8dcff",
      "$description": "Labels, headings, notes and buttons in the settings window: a light blue, lighter than the Handicap's hand-typed values (blue-74). Green is information there: what's on, lit or working (the user, Nov 6 2026).",
      "$extensions": {
        "fan": {
          "light": "#1c6aa8"
        }
      }
    },
    "label-edge": {
      "$value": "rgb(168 220 255 / .35)",
      "$description": "The label blue, faint: the Application tab's headings' outline, for a little pop without shouting (the user, Nov 6 2026).",
      "$extensions": {
        "fan": {
          "light": "rgb(28 106 168 / .35)"
        }
      }
    },
    "accent": {
      "$value": "#5fd0a6",
      "$description": "What's active or chosen: focus rings, a lit border, the Place button.",
      "$extensions": {
        "fan": {
          "light": "#11845a"
        }
      }
    },
    "accent-ink": {
      "$value": "#07110d",
      "$description": "Text on the accent.",
      "$extensions": {
        "fan": {
          "light": "#ffffff"
        }
      }
    },
    "danger": {
      "$value": "#ff7a70",
      "$description": "A field that's wrong, and its message.",
      "$extensions": {
        "fan": {
          "light": "#c2382e"
        }
      }
    },
    "live": {
      "$value": "#f2b84b",
      "$description": "A game under way.",
      "$extensions": {
        "fan": {
          "light": "#a86b0c"
        }
      }
    },
    "good": {
      "$value": "#19e37a",
      "$description": "Working or winning: a status that's green, a positive P/L, the axis's gains.",
      "$extensions": {
        "fan": {
          "light": "#0d8a47"
        }
      }
    },
    "bad": {
      "$value": "#ff3d3d",
      "$description": "Losing: a negative P/L, the axis's losses, on air.",
      "$extensions": {
        "fan": {
          "light": "#d01f1f"
        }
      }
    },
    "warn": {
      "$value": "#ffb52e",
      "$description": "A warning: a status that's amber, a stale note, a version behind.",
      "$extensions": {
        "fan": {
          "light": "#a96a00"
        }
      }
    },
    "error": {
      "$value": "#ff6b6b",
      "$description": "Something that failed: an order's error, a Delete that waits for sure.",
      "$extensions": {
        "fan": {
          "light": "#c62f2f"
        }
      }
    },
    "selected": {
      "$value": "#ff8c1a",
      "$description": "The selected tab's marks, the chosen league tile, the wall's loud window.",
      "$extensions": {
        "fan": {
          "light": "#d96a00"
        }
      }
    },
    "turf": {
      "$value": "#12361b",
      "$description": "The NFL's field green: hovered tabs, the Fan button's gear, the NFL's tile."
    },
    "overlay-3": {
      "$value": "rgb(255 255 255 / .03)",
      "$description": "A faint lift over paper: a row under the pointer.",
      "$extensions": {
        "fan": {
          "light": "rgb(0 0 0 / .03)"
        }
