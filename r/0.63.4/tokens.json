  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Barlow Condensed",
        "Arial Narrow",
        "sans-serif"
      ],
      "$description": "Headings, tabs and the big buttons."
    },
    "league": {
      "$value": [
        "Saira Stencil One",
        "{font.display}"
      ],
      "$description": "The league on screen's own face, for league things only: the NFL's stencil; the NBA and NHL set theirs in fan.css."
    },
    "mono": {
      "$value": [
        "Chivo Mono",
        "ui-monospace",
        "Consolas",
        "monospace"
      ],
      "$description": "Numbers and the page's body."
    },
    "label": {
      "$value": [
        "Sofia Sans Extra Condensed",
        "Arial Narrow",
        "sans-serif"
      ],
      "$description": "Tiny caps labels: column heads, card labels, section and slot headings, axis captions."
    }
  },
  "$extensions": {
    "fan": {
      "darkAlways": [
        "#code",
        ".trade-tip",
        "#graphs.bare",
        ".board .team-name.live"
      ],
      "about": "A light value per role, used in light mode (the user, Nov 6 2026); the panels named in darkAlways keep the dark values in either mode."
    }
  }
}
